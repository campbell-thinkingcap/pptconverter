# API key for programmatic access (Postman, integrations).
# Leave empty to disable API key auth.
API_KEY=

# Google OAuth — enables sign-in on the upload page.
# Create a Web Application OAuth client at console.cloud.google.com
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed email domains.
# Leave empty to allow any Google account.
ALLOWED_DOMAINS=thinkingcap.com
